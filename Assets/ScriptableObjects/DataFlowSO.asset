      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Zrobi\u0142o ci si\u0119 przyjemnie ch\u0142odno..."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "I umar\u0142a\u015B. "
      - timeForSingleCharDisplay: 1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Anio\u0142y przekaza\u0142y ci, \u017Ce Mateusz uciek\u0142. "
      - timeForSingleCharDisplay: 1
        subline: 
