  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Szale\u0144cy. "
      - timeForSingleCharDisplay: 0.05
        subline: ' Dziwacy. '
      - timeForSingleCharDisplay: 0.05
        subline: 'Wyrzutki. '
      - timeForSingleCharDisplay: 0.05
        subline: 'Samotni, ale nie z wyboru. '
      - timeForSingleCharDisplay: 0.05
        subline: "Trudno jest im nawi\u0105za\u0107 g\u0142\u0119bokie relacje -
          jednak my im pomo\u017Cemy."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Witamy w programie, w kt\xF3rym kilku wyj\u0105tkowych uczestnik\xF3w
          zmierzy si\u0119 z trudnymi wyzwaniami i "
      - timeForSingleCharDisplay: 0.05
        subline: "- by\u0107 mo\u017Ce - "
      - timeForSingleCharDisplay: 0.05
        subline: "zdob\u0119dzie przyjaci\xF3\u0142 do grobowej deski."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: Oto...
      - timeForSingleCharDisplay: 0.05
        subline: FriendlyFire.
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.01
        subline: ' '
      lingering: 0
      speakerID: I
      speakerMod: A2
      changeLocationId: 1
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Zebrali\u015Bmy sze\u015Bciu bardzo ciekawych ludzi, kt\xF3rzy
          z jakiego\u015B powodu nie znale\u017Ali swoich bratnich dusz."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "\u017BYWEGO MNIE NIE WE\u0179MIECIE!"
      lingering: -1
      speakerID: I
      speakerMod: L1
      changeLocationId: 
