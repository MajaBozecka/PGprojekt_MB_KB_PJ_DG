  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "NIE PODDAMY SI\u0118!"
      lingering: -1
      speakerID: I
      speakerMod: G1
      changeLocationId: 7
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Trzymajcie si\u0119 przyjaciele! "
      - timeForSingleCharDisplay: 0.1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Nie dajcie si\u0119 oszuka\u0107!"
      lingering: -1
      speakerID: I
      speakerMod: H1
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: I
      speakerMod: Exit
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Krystian wyskoczy\u0142 przez okno i pobieg\u0142 w sin\u0105 dal."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: ...Aha.
      lingering: -1
      speakerID: Ad
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: ...
      - timeForSingleCharDisplay: 1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: No to co dalej?
      lingering: -1
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "\u0141apiemy go. Albo popadamy w d\u0142ugi."
      lingering: 2
      speakerID: Ad
      speakerMod: A1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
