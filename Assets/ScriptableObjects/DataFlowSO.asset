      speakerMod: M1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Was wszystkich chyba por\u0105ba\u0142o!!!"
      lingering: 0
      speakerID: Mz
      speakerMod: D3
