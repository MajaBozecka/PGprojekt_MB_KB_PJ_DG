    identifier: GirlsRoom
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Szale\u0144cy. "
      - timeForSingleCharDisplay: 0.05
        subline: ' Dziwacy. '
      - timeForSingleCharDisplay: 0.05
        subline: 'Wyrzutki. '
      - timeForSingleCharDisplay: 0.05
        subline: 'Samotni, ale nie z wyboru. '
      - timeForSingleCharDisplay: 0.05
        subline: "Trudno jest im nawi\u0105za\u0107 g\u0142\u0119bokie relacje -
          jednak my im pomo\u017Cemy."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Witamy w programie, w kt\xF3rym kilku wyj\u0105tkowych uczestnik\xF3w
          zmierzy si\u0119 z trudnymi wyzwaniami i "
      - timeForSingleCharDisplay: 0.05
        subline: "- by\u0107 mo\u017Ce - "
      - timeForSingleCharDisplay: 0.05
        subline: "zdob\u0119dzie przyjaci\xF3\u0142 do grobowej deski."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: Oto...
      - timeForSingleCharDisplay: 0.05
        subline: FriendlyFire.
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.01
        subline: ' '
      lingering: 0
      speakerID: I
      speakerMod: A2
      changeLocationId: 1
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Zebrali\u015Bmy sze\u015Bciu bardzo ciekawych ludzi, kt\xF3rzy
          z jakiego\u015B powodu nie znale\u017Ali swoich bratnich dusz."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "\u017BYWEGO MNIE NIE WE\u0179MIECIE!"
      lingering: -1
      speakerID: I
      speakerMod: L1
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: I
      speakerMod: Exit
      changeLocationId: 10
    - subLines: []
      lingering: 0.05
      speakerID: Ma
      speakerMod: A1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Zamierzamy odkry\u0107 to, co odstrasza od nich normalnych ludzi..."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines: []
      lingering: 2
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: Ma
      speakerMod: Exit
      changeLocationId: 8
    - subLines: []
      lingering: 0
      speakerID: Mz
      speakerMod: A1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "... i postaramy si\u0119 odnale\u017A\u0107 spos\xF3b \u017Ceby
          zamieni\u0107 to w co\u015B pozytywnego!"
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: Idealna impreza?
      lingering: -1
      speakerID: Mz
      speakerMod: A2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "W moim pokoju z pizz\u0105 i kocykiem... "
      - timeForSingleCharDisplay: 0.02
        subline: Haha!
      lingering: -1
      speakerID: Mz
      speakerMod: A4
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: Jestem bardzo samotny.
      lingering: -1
      speakerID: Mz
      speakerMod: D3
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Przez wykonywanie zada\u0144, nasi uczestnicy pozostan\u0105 zmuszeni
          do interakcji spo\u0142ecznych, od kt\xF3rych nie b\u0119d\u0105 mogli
          uciec! "
      - timeForSingleCharDisplay: 0.05
        subline: "Mo\u017Ce to sprawi, \u017Ce nawi\u0105\u017C\u0105 nowe znajomo\u015Bci?"
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: Mz
      speakerMod: Exit
      changeLocationId: 12
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Nazywam si\u0119 Oktawian \u0141askawca. Jestem w tym programie,
          poniewa\u017C nie mam z kim jecha\u0107 na wesele mojego kuzyna, kt\xF3re
          odb\u0119dzie si\u0119 w Monako."
      lingering: -1
      speakerID: O
      speakerMod: A1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.25
        subline: ...
      lingering: -1
      speakerID: O
      speakerMod: A1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "I chyba nadal nie b\u0119d\u0119 mia\u0142."
      lingering: -1
      speakerID: O
      speakerMod: A1
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: O
      speakerMod: Exit
      changeLocationId: 9
    - subLines: []
      lingering: 0
      speakerID: A
      speakerMod: I2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Heej, jestem Antonina Wiercipi\u0119ta i jestem w tym programie,
          poniewa\u017C brzmi to ciekawie i mo\u017Ce poznam jakich\u015B fajnych
          ludzi."
      lingering: -1
      speakerID: A
      speakerMod: I1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: " I b\u0119dziemy mogli robi\u0107 imprezy pi\u017Camowe i chodzi\u0107
          do kina. I robi\u0107 bransoletki przyja\u017Ani, takie z koralik\xF3w,
          z naszymi imionami!"
      lingering: 0.3
      speakerID: A
      speakerMod: M2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Oooo! Tak!
      lingering: 0.5
      speakerID: A
      speakerMod: M4
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "I kupowa\u0107 razem ubrania i gada\u0107 o ch\u0142opakach!"
      lingering: 0
      speakerID: A
      speakerMod: L1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: " A mo\u017Ce poznam jakiego\u015B ch\u0142opaka i b\u0119dziemy
          par\u0105??? A jak nie to nic, bo b\u0119d\u0119 mia\u0142a przyjaci\xF3\u0142
          i opowiem im o wszystkich ciekawych pomys\u0142ach, kt\xF3re mam! Mam wiele
          pomys\u0142\xF3w, naprawd\u0119, kiedy\u015B wam opowiem je\u015Bli b\u0119dziecie
          chcieli zrobi\u0107 z nich program czy co\u015B!"
      lingering: 0
      speakerID: A
      speakerMod: L2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Mam taki pomys\u0142 na program, w kt\xF3rym jest dziewczyna i
          ona ma zastawione oczy i s\u0105 inni uczestnicy."
      lingering: 0
      speakerID: A
      speakerMod: L1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: I jakby eee...
      lingering: 0
      speakerID: A
      speakerMod: M1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Ci inni uczestnicy udaj\u0105, \u017Ce s\u0105 jedn\u0105 osob\u0105."
      lingering: 0
      speakerID: A
      speakerMod: L2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: " Ale ta dziewczyna o tym nie wie. I- haha! - I zobaczymy ile jej
          zajmie doj\u015Bcie do tego, \u017Ce randkuje z pi\u0119cioma r\xF3\u017Cnymi
          facetami. To by\u0142oby mega \u015Bmieszne. Jakby- Jakby ja wiem, \u017Ce
          to mo\u017Ce nie brzmi tak zabawnie, ale uwierzcie mi."
      lingering: 0.3
      speakerID: A
      speakerMod: L2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Mam wizj\u0119."
      lingering: 0.5
      speakerID: A
      speakerMod: A8
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Tylko nie wiem jak mo\u017Cnaby by\u0142o przekona\u0107 dziewczyn\u0119
          do udzia\u0142u w tym programie. "
      lingering: 0
      speakerID: A
      speakerMod: I4
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "A i, zapomnia\u0142am prawie, ci faceci nie b\u0119d\u0105 si\u0119
          ze sob\u0105 komunikowa\u0107, wi\u0119c to b\u0119dzie taki du\u017Cy
          mind game. Intrygi, spiski, troch\u0119 jak, troch\u0119 jak to detektywistyczne
          anime ale bez u\u015Bmiercania ludzi notatnikiem."
      lingering: 0
      speakerID: A
      speakerMod: L1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Taki mia\u0142am pomys\u0142."
      lingering: 0.1
      speakerID: A
      speakerMod: A8
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "A, o czym ja m\xF3wi\u0142am w og\xF3le, bo chyba zboczy\u0142am
          z tematu?"
      lingering: 0
      speakerID: A
      speakerMod: L1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Hmmm...
      lingering: 1
      speakerID: A
      speakerMod: I2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "O. O i, i b\u0119dziemy je\u017Adzili samochodem na przygody i
          \u015Bpiewali piosenki podczas drogi."
      lingering: 0
      speakerID: A
      speakerMod: L2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: " Uwielbiam \u015Bpiewa\u0107 piosenki, ale nie bardzo umiem."
      lingering: 0
      speakerID: A
      speakerMod: I1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Ooo i b\u0119dziemy robili sobie warkoczyki i maseczki i siedzieli
          wieczorami ze sob\u0105 i nie robili nawet nic konkretnego, ale w swojej
          przestrzeni i to by\u0142oby takie mega."
      lingering: 0
      speakerID: A
      speakerMod: M2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "I spacerowaliby\u015Bmy mo\u017Ce noc\u0105 po lesie. I b\u0119dziemy
          mieli inside joke'i, kt\xF3re b\u0119d\u0105 \u015Bmieszy\u0107 tylko nas
          i my b\u0119dziemy je rozumie\u0107, ale dziewczyny z mojego liceum nie
          b\u0119d\u0105 i b\u0119d\u0105 mi zazdro\u015Bci\u0107, \u017Ce mam najlepsz\u0105
          grup\u0119 przyjaci\xF3\u0142 ever i b\u0119dziemy si\u0119 \u015Bwietnie
          w tej grupie dogadywa\u0107 i skaka\u0107 przez p\u0142oty i robi\u0107
          noce filmowe i -"
      lingering: 0.2
      speakerID: A
      speakerMod: L2
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: A
      speakerMod: Exit
      changeLocationId: 8
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nazywam si\u0119 Mateusz Pomara\u0144cza..."
      lingering: -1
      speakerID: Mz
      speakerMod: A1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: 'Jestem tu, bo bracia mnie zmusili... '
      - timeForSingleCharDisplay: 0
        subline: He.
      lingering: -1
      speakerID: Mz
      speakerMod: F1
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: Mz
      speakerMod: Exit
      changeLocationId: 2
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nazywam si\u0119 Matylda Mr\xF3z."
      - timeForSingleCharDisplay: 0
        subline: " Interesuj\u0119 si\u0119 chemi\u0105."
      lingering: -1
      speakerID: Ma
      speakerMod: F3
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: " Zosta\u0142am tu wezwana przez G\u0142osy."
      lingering: -1
      speakerID: Ma
      speakerMod: F3
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: Ma
      speakerMod: Exit
      changeLocationId: 1
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nie wyrazi\u0142em zgody na udzia\u0142 w tym programie, nie by\u0142em
          przy zdrowych zmys\u0142ach podczas podpisywania dokument\xF3w. "
      lingering: -1
      speakerID: I
      speakerMod: H9
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Widz\u0119 wasze zagrywki, szczury."
      lingering: -1
      speakerID: I
      speakerMod: A2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Je\u015Bli nie wyjd\u0119 st\u0105d \u017Cywy, to wiedzcie, \u017Ce
          zabili mnie Wielbiciele \u0141\u0105ki i \u017Ce chc\u0105 teraz przej\u0105\u0107
          kontrol\u0119 nad \u015Bwiatem."
      lingering: -1
      speakerID: I
      speakerMod: K1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: ALE NIE DAM IM SATYSFAKCJI!
      lingering: -1
      speakerID: I
      speakerMod: G1
      changeLocationId: 
