  dialogueSequenceList:
  - lines: []
    identifier: 0EXIT_Dialogue
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Na pod\u0142odze nadal jest krew."
      lingering: -1
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    identifier: Blood_Floor
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Tsk. Kto\u015B usun\u0105\u0142 nagrania z dzisiejszej nocy."
      lingering: -1
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    identifier: Cameras1
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Hm. Kamery nie wychwyci\u0142y nic przydatnego."
      - timeForSingleCharDisplay: 0
        subline: "Wydaj\u0105 mi si\u0119 absurdalnie niepotrzebne."
      lingering: -1
      speakerID: Gracz
      speakerMod: ' '
      changeLocationId: 
    identifier: Cameras2
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Okej. Wreszcie sko\u0144czy\u0142am."
      lingering: -1
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 0
    identifier: Ch1_
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "To podstawowe pytania podczas przes\u0142uchiwania \u015Bwiadk\xF3w"
      lingering: 0
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Och. W takim razie przepraszam.
      lingering: 0
      speakerID: A
      speakerMod: 
      changeLocationId: 
    identifier: Ch1_Antonina_Panic_Procedure
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nale\u017Cy pani do grupy podejrzanych."
      lingering: 0
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Co??? Dlaczego???
      lingering: 0
      speakerID: A
      speakerMod: 
      changeLocationId: 
    identifier: Ch1_Antonina_Panic_Witness
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "...Poniewa\u017C znajdowa\u0142a si\u0119 pani w pobli\u017Cu miejsca
          zbrodni kiedy do niej dosz\u0142o?"
      lingering: 0
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: ...To ma sens.
      lingering: 0
      speakerID: A
      speakerMod: 
      changeLocationId: 
    identifier: Ch1_Antonina_Panic_Witness1+0S
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Ka\u017Cdy jest podejrzany."
      lingering: 0
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
