        subline: "Krystian, Rafa\u0142 i Adam ruszyli za Mateuszem"
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
