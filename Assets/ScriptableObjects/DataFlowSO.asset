      speakerMod: F2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Ania, z ca\u0142ym szacunkiem, "
      - timeForSingleCharDisplay: 0.1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "ale w \u017Cyciu nie wsp\xF3\u0142pracowa\u0142bym z Antonin\u0105
          w czymkolwiek, co wymaga bycia dyskretnym."
      lingering: -1
      speakerID: Mz
      speakerMod: C2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: 'Ejjj... '
      - timeForSingleCharDisplay: 0.1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Czy to znaczy, \u017Ce zabiliby\u015Bcie kogo\u015B "
      - timeForSingleCharDisplay: 0.2
        subline: 
      lingering: -1
      speakerID: A
      speakerMod: F2
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: Mz
      speakerMod: F2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: BEZE MNIE?
      - timeForSingleCharDisplay: 0.2
        subline: ...
      lingering: -1
      speakerID: A
      speakerMod: B4
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nie \u017Cebym chcia\u0142a kogo\u015B zabi\u0107, ale troch\u0119
          mi przykro, \u017Ce mnie wykluczacie."
      lingering: -1
      speakerID: A
      speakerMod: E5
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nie wykluczamy ci\u0119. "
      - timeForSingleCharDisplay: 0.5
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Nie planowali\u015Bmy zab\xF3jstwa, ale w jakim\u015B bardzo popsutym
          \u015Bwiecie, w kt\xF3rym by\u015Bmy planowali, by\u0142aby\u015B pierwsz\u0105
          osob\u0105, kt\xF3ra by o tym us\u0142ysza\u0142a."
      lingering: -1
      speakerID: I
      speakerMod: M1
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: I
      speakerMod: H16
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Aww, dzi\u0119kuj\u0119!"
      lingering: -1
      speakerID: A
      speakerMod: I1
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: Ma
      speakerMod: F12
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "G\u0142\xF3wnie dlatego, \u017Ce popsu\u0142oby to nasze plany,
          a ja JESTEM PRZECIWNY zab\xF3jstwom, ale r\xF3wnie\u017C dlatego, \u017Ce
          z tob\u0105 by\u0142oby to du\u017Co zabawniejsze."
      lingering: -1
      speakerID: I
      speakerMod: H3
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: A
      speakerMod: A14
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: I
      speakerMod: H17
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Czyli nie wsp\xF3\u0142pracowali\u015Bmy, \u017Ceby zabi\u0107
          Oktawiana?"
      lingering: -1
      speakerID: R
      speakerMod: C1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Nie.
      lingering: 0.5
      speakerID: A
      speakerMod: A10
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Nie.
      lingering: 0.5
      speakerID: Mz
      speakerMod: B1
      changeLocationId: 
    - subLines: []
      lingering: 0
      speakerID: R
      speakerMod: C3
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Mimo tego, \u017Ce ta teoria wydaje si\u0119 bardzo ekscytuj\u0105ca
          i kusz\u0105ca, nie ma szans, \u017Ce zrobili to oni wszyscy."
      lingering: -1
      speakerID: Ad
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "(I je\u017Celi pozwiemy ich wszystkich i oka\u017Ce si\u0119, \u017Ce
          byli\u015Bmy w b\u0142\u0119dzie, nigdy nie wyjdziemy z d\u0142ug\xF3w.)"
      lingering: 0
      speakerID: Ad
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Ania, masz dowody?
      lingering: -1
      speakerID: Ad
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Um, c\xF3\u017C, nie do-"
      lingering: 0
      speakerID: Gracz
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: 'GEKHEM. SUPER. '
      lingering: 0
      speakerID: Ad
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nie jeste\u015B. Hercule Poirot."
      - timeForSingleCharDisplay: 0.2
        subline: 
      - timeForSingleCharDisplay: 0
        subline: ' To nie Orient Express,'
      - timeForSingleCharDisplay: 0
        subline: 
      - timeForSingleCharDisplay: 0
        subline: " Ani nie masz poka\u017Anego w\u0105sa."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "A wi\u0119c, Ania, kto zabi\u0142?"
      lingering: -1
      speakerID: Ad
      speakerMod: 
      changeLocationId: 
