      speakerID: Ma
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Okej, okej!
      lingering: -1
      speakerID: A
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: 'Halo? Karetka? Eee... '
      - timeForSingleCharDisplay: 1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Tak, dosz\u0142o do wypadku znaczy- "
      - timeForSingleCharDisplay: 1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Antonina Wiercipi\u0119ta, tak. Moja znajoma- "
