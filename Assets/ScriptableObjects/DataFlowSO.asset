      lingering: 0
      speakerID: I
      speakerMod: Exit
      changeLocationId: 10
    - subLines: []
      lingering: 0.05
      speakerID: Ma
      speakerMod: A1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0.05
        subline: "Zamierzamy odkry\u0107 to, co odstrasza od nich normalnych ludzi..."
      lingering: -1
      speakerID: Narrator
      speakerMod: 
      changeLocationId: 
    - subLines: []
      lingering: 2
