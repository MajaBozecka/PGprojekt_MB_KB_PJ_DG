        subline: "Ju\u017C m\xF3wi\u0142am!"
      lingering: -1
      speakerID: A
      speakerMod: 
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Nagle przesta\u0142a\u015B by\u0107 w stanie utrzyma\u0107 g\u0142owy
