    identifier: NZAagree
    runnedAlready: 0
  - lines:
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: 'Owszem. '
      - timeForSingleCharDisplay: 0.2
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Wyszed\u0142em z pokoju w \u015Brodku nocy, kiedy nikt mnie nie
          s\u0142ysza\u0142. "
      - timeForSingleCharDisplay: 0.3
        subline: 
      - timeForSingleCharDisplay: 0
        subline: "Oktawian przebywa\u0142 w damskiej toalecie-"
      lingering: -1
      speakerID: I
      speakerMod: H11
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "chcia\u0142 zamontowa\u0107 tam ukryte kamery, \u017Ceby podgl\u0105da\u0107
          dziewczyny."
      - timeForSingleCharDisplay: 0.3
        subline: 
      - timeForSingleCharDisplay: 0
        subline: " Uzna\u0142em to za obrzydliwe i niegodne cz\u0142owieka,"
      - timeForSingleCharDisplay: 0.1
        subline: 
      - timeForSingleCharDisplay: 0
        subline: " wi\u0119c wzi\u0105\u0142em \u017Celazko z szafki przy sypialniach
          i poszed\u0142em jego tropem."
      lingering: -1
      speakerID: I
      speakerMod: K1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: " Kiedy tam by\u0142em, zamachn\u0105\u0142em si\u0119 i uderzy\u0142em
          Oktawiana w ty\u0142 g\u0142owy."
      - timeForSingleCharDisplay: 0.3
        subline: 
      - timeForSingleCharDisplay: 0
        subline: " Potem szybko pobieg\u0142em do m\u0119skiej toalety aby zmy\u0107
          z \u017Celazka \u015Blady krwii i od\u0142o\u017Cy\u0142em je na stoliku
          w pokoju dziennym."
      lingering: -1
      speakerID: I
      speakerMod: O2
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: "Uzna\u0142em, \u017Ce je\u015Bli po\u0142o\u017C\u0119 je w g\u0142upim
          miejscu podejrzenie spadnie na kogo\u015B innego,"
      - timeForSingleCharDisplay: 0.3
        subline: 
      - timeForSingleCharDisplay: 0
        subline: " bo jestem znany z dok\u0142adno\u015Bci."
      lingering: -1
      speakerID: I
      speakerMod: N1
      changeLocationId: 
    - subLines:
      - timeForSingleCharDisplay: 0
        subline: Czy ta historia brzmi prawdopodobnie, Ania?
      lingering: -1
      speakerID: Ad
      speakerMod: 
      changeLocationId: 
